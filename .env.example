# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# The Studio app supports BOTH the legacy JWT keys (anon / service_role) and
# the new "API Key v2" format (sb_publishable_* / sb_secret_*). Either works
# in @supabase/supabase-js — pick whichever your dashboard shows. The legacy
# keys you already have are 100% supported and will keep working.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...           # or sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # or sb_secret_...

# Used ONLY by /studio/scripts/migrate-*.ts (CLI, never bundled).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend) — defaults used by submit-form / invitations.
# Per-site Resend keys can be set in Studio → Settings; those override these.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Studio <noreply@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (server-side secret + public site key)
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=0x...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# ─────────────────────────────────────────────────────────────────────────────
# Preview JWT — sites use this to verify ?preview=<token> draft links.
# ─────────────────────────────────────────────────────────────────────────────
PREVIEW_JWT_SECRET=change-me-min-32-chars-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# Public-API CORS allow-list. Per-site overrides in Settings.
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://kingsbridgeimmigration.ca,https://searchhub.digital

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — Kingsbridge $1 webinar Payment Link + webhook
# ─────────────────────────────────────────────────────────────────────────────
# Payment Link URL (client_reference_id + prefilled_email are appended by CMS).
WEBINAR_STRIPE_PAYMENT_LINK=https://buy.stripe.com/4gMdR9fu1a1XfrN6vB3Je09
# Stripe Dashboard → Developers → Webhooks → endpoint
#   https://<cms-host>/api/v1/webhooks/stripe
# Events: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────────────────────────────────────
# Meta Conversions API — Kingsbridge Pixel (do NOT reinstall Pixel; browser
# Pixel stays on kingsbridgeimmigration.ca). CAPI runs from CMS only.
# Events Manager → Data sources → Pixel → Settings → Generate access token
# Optional: META_TEST_EVENT_CODE from Test Events tab (remove after QA).
# ─────────────────────────────────────────────────────────────────────────────
META_PIXEL_ID=1000856715673214
META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=TEST12345

# ─────────────────────────────────────────────────────────────────────────────
# Brevo — webinar client emails (prefer per-site Settings in CMS dashboard).
# Platform env is fallback only when site fields are empty.
# Prefer BREVO_API_KEY (xkeysib-…). SMTP is fallback for send-only.
# Cron: Vercel hits /api/v1/cron/webinar-emails every minute → CRON_SECRET required.
# ─────────────────────────────────────────────────────────────────────────────
# BREVO_API_KEY=xkeysib-...
# BREVO_SMTP_LOGIN=...@smtp-brevo.com
# BREVO_SMTP_KEY=xsmtpsib-...
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_FROM_EMAIL=Kingsbridge Immigration <noreply@kingsbridgeimmigration.ca>
# BREVO_FROM_NAME=Kingsbridge Immigration
# BREVO_LEADS_LIST_ID=
# BREVO_REGISTERED_LIST_ID=
# WEBINAR_DATE_LABEL=October 21, 2026
# WEBINAR_LOCAL_TIME_LABEL=12:30 PM America/Toronto
# WEBINAR_TIMEZONE=America/Toronto
# WEBINAR_ZOOM_URL=https://us06web.zoom.us/j/...
# WEBINAR_ZOOM_MEETING_ID=811 1532 8974
# WEBINAR_ZOOM_PASSCODE=532418
# WEBINAR_UNPAID_REMINDER_MINUTES=5
# CRON_SECRET=long-random-string

